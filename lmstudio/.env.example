# Point a Laravel app running laravel/ai at the local model.
# Copy to the application root as .env and adjust.

# The OpenAI-compatible door.
AI_PROVIDER=openai
OPENAI_BASE_URL=http://localhost:1234/v1

# Ignored by the local server; any string works.
OPENAI_API_KEY=lm-studio

# The model identifier as LM Studio reports it in /v1/models.
AI_CHAT_MODEL=qwen3.8-27b

# Optional: a smaller model for vision or OCR, loaded alongside.
# AI_OCR_MODEL=qwen2.5-vl-7b

# For a Claude client instead, use the Anthropic-compatible door:
# ANTHROPIC_BASE_URL=http://localhost:1234
